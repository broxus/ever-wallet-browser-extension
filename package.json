{
  "name": "sparx-wallet",
  "version": "2.0.3",
  "description": "SparX Wallet browser extension",
  "scripts": {
    "start": "webpack --mode=development --watch --stats-error-details --env beta",
    "start:firefox": "webpack --mode=development --watch --stats-error-details --env firefox",
    "build:prod": "webpack --mode=production",
    "build:beta": "webpack --mode=production --env beta",
    "build:firefox": "webpack --mode=production --env firefox",
    "release:firefox": "npm run build:firefox && web-ext build --source-dir=dist --artifacts-dir=release",
    "compress": "sh scripts/build.sh",
    "release:prod": "npm run build:prod && npm run archive -- -v prod",
    "release:beta": "npm run build:beta && npm run archive -- -v beta",
    "release": "npm run download-config && rm -rf release && npm run release:beta && npm run release:prod",
    "archive": "sh scripts/create-archive.sh",
    "generate-icons": "node scripts/generate-icons.js",
    "download-config": "sh scripts/download-config.sh",
    "lint": "eslint ./src --ext .tsx,.ts --quiet --cache --cache-location ./node_modules/.cache/",
    "prepare": "husky",
    "generate:api-gassless": "openapi-generator-cli generate -i openapi.yml -g typescript-fetch -o src/api/gassless --additional-properties=useSingleRequestParameter=true,supportsES6=true,modelPropertyNaming=camelCase",
    "generate:api-nft": "openapi-generator-cli generate -i src/api/nft/openapi.json -g typescript-fetch -o src/api/nft --additional-properties=useSingleRequestParameter=true,supportsES6=true,modelPropertyNaming=camelCase"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/broxus/ever-wallet-browser-extension.git"
  },
  "author": "",
  "license": "GNU GPL v3.0",
  "dependencies": {
    "@broxus/await-semaphore": "^0.1.5",
    "@openapitools/openapi-generator-cli": "^2.25.2",
    "@rive-app/react-canvas-lite": "^4.24.0",
    "bignumber.js": "^9.3.1",
    "@broxus/ever-wallet-wasm": "0.5.1-beta.1",
    "buffer": "^6.0.3",
    "classnames": "^2.5.1",
    "copy-to-clipboard": "^3.3.3",
    "end-of-stream": "^1.4.5",
    "everscale-inpage-provider": "0.6.3",
    "fast-levenshtein": "^3.0.0",
    "fast-safe-stringify": "^2.1.1",
    "flat": "^6.0.1",
    "is-stream": "^3.0.0",
    "jdenticon": "^3.3.0",
    "lodash.clonedeep": "^4.5.0",
    "lodash.debounce": "^4.0.8",
    "lodash.groupby": "^4.6.0",
    "lodash.isequal": "^4.5.0",
    "lodash.memoize": "^4.1.2",
    "lodash.sortby": "^4.7.0",
    "lodash.uniqwith": "^4.5.0",
    "loglevel": "^1.9.2",
    "mobx": "^6.15.0",
    "mobx-react-lite": "^4.1.1",
    "nanoid": "^5.1.6",
    "nekoton-wasm": "1.7.1-beta.0",
    "obj-multiplex": "^1.0.0",
    "object-code": "^1.3.4",
    "post-message-stream": "^3.0.0",
    "process": "^0.11.10",
    "pump": "^3.0.3",
    "punycode": "^2.3.1",
    "rc-select": "^14.16.8",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-focus-lock": "^2.13.7",
    "react-hook-form": "^7.68.0",
    "react-intl": "^7.1.14",
    "react-qr-code": "^2.0.18",
    "react-router": "^7.10.1",
    "react-router-dom": "^7.10.1",
    "react-tiny-popover": "^8.1.6",
    "react-tooltip": "^5.30.0",
    "react-transition-group": "^4.4.5",
    "react-virtuoso": "^4.17.0",
    "readable-stream": "4.7.0",
    "reflect-metadata": "^0.2.2",
    "semver": "^7.7.3",
    "stream-browserify": "^3.0.0",
    "tsyringe": "^4.10.0",
    "usehooks-ts": "^3.1.1",
    "util": "^0.12.5",
    "web-ext": "^9.2.0",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@broxus/eslint-config": "4.1.2",
    "@svgr/webpack": "^8.1.0",
    "@types/chrome": "^0.1.32",
    "@types/classnames": "^2.3.4",
    "@types/end-of-stream": "^1.4.4",
    "@types/fast-levenshtein": "^0.0.4",
    "@types/lodash.clonedeep": "^4.5.9",
    "@types/lodash.debounce": "^4.0.9",
    "@types/lodash.groupby": "^4.6.9",
    "@types/lodash.isequal": "^4.5.8",
    "@types/lodash.memoize": "^4.1.9",
    "@types/lodash.sortby": "^4.7.9",
    "@types/lodash.uniqwith": "^4.5.9",
    "@types/post-message-stream": "^3.0.4",
    "@types/pump": "^1.1.3",
    "@types/punycode": "^2.1.4",
    "@types/react": "^19.2.7",
    "@types/react-copy-to-clipboard": "^5.0.7",
    "@types/react-dom": "^19.2.3",
    "@types/react-transition-group": "^4.4.12",
    "@types/readable-stream": "^4.0.23",
    "@types/semver": "^7.7.1",
    "@types/webextension-polyfill": "^0.10.0",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^7.1.2",
    "eslint": "^9.39.1",
    "file-loader": "^6.2.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "globals": "^16.5.0",
    "html-webpack-plugin": "^5.6.5",
    "husky": "^9.1.7",
    "sass": "^1.96.0",
    "sass-loader": "^16.0.6",
    "sass-resources-loader": "^2.2.5",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "webpack": "^5.103.0",
    "webpack-cli": "6.0.1"
  }
}
